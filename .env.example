# Cloudflare Worker local development
# Copy these values to apps/worker/.dev.vars for `npm run dev`.
# Remote secrets are loaded with `wrangler secret put`, never committed.

TELEGRAM_BOT_TOKEN=replace-with-token-from-botfather
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
JWT_SECRET=replace-with-a-long-random-session-secret
PII_HASH_SECRET=replace-with-a-different-long-random-secret
# Exactly 32 random bytes encoded with base64url.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PAYMENT_DETAILS_ENCRYPTION_KEY=replace-with-32-byte-base64url-key

# Public Worker configuration lives in apps/worker/wrangler.toml:
# APP_ORIGIN=https://your-pages-project.pages.dev
# API_ORIGIN=https://your-worker.your-account.workers.dev
# PLATFORM_USDT_NETWORK=TRC20
# PLATFORM_USDT_ADDRESS=your-platform-usdt-wallet
# ADULT_DECLARATION_VERSION=2026-08

# Cloudflare Pages build-time setting, not a secret:
NEXT_PUBLIC_API_ORIGIN=https://your-worker.your-account.workers.dev

# EnergixCu agent — WhatsApp Cloud API + Facebook Messenger (Worker secrets)
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-verify-token
WHATSAPP_ACCESS_TOKEN=replace-with-meta-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-whatsapp-phone-number-id
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
MESSENGER_PAGE_ACCESS_TOKEN=replace-with-page-access-token
MESSENGER_APP_SECRET=replace-with-meta-app-secret
AGENT_ADMIN_KEY=replace-with-admin-key-for-tickets-and-daily-products
